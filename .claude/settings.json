{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/credentials*)",
      "Read(**/secrets*)",
      "Read(**/tokens.json)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.kube/**)",
      "Read(~/.azure/**)",
      "Read(~/.bash_history)",
      "Read(~/.zsh_history)",
      "bash:cat ~/.ssh/*",
      "bash:cat .env*",
      "bash:cat *credentials*",
      "bash:cat *secret*",
      "bash:cat **/tokens.json",
      "bash:cat ~/.config/gcloud/*",
      "bash:cat ~/.aws/*",
      "bash:cat ~/.kube/*",
      "bash:head .env*",
      "bash:tail .env*",
      "bash:less .env*",
      "bash:more .env*",
      "bash:awk * .env*",
      "bash:sed * .env*",
      "edit:.env",
      "edit:.env.local",
      "edit:**/credentials.json",
      "edit:**/tokens.json"
    ]
  }
}
