# Phish Triage MCP Server — API Keys
# Copy this to .env and fill in your keys. NEVER commit .env.
# All keys are optional — tools will return helpful errors if unconfigured.

# URLScan.io — free tier: 100 scans/day
# Sign up: https://urlscan.io/user/signup
URLSCAN_API_KEY=

# Google Safe Browsing — free tier: 10,000 requests/day
# Enable via Google Cloud Console: https://console.cloud.google.com/apis/library/safebrowsing.googleapis.com
GOOGLE_SAFE_BROWSING_API_KEY=

# AbuseIPDB — free tier: 1,000 checks/day
# Sign up: https://www.abuseipdb.com/register
ABUSEIPDB_API_KEY=

# VirusTotal — free tier: 4 requests/minute, 500/day
# Sign up: https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=
