# 1Password secret references for phish-triage API keys.
# Resolved at runtime via `op run --env-file=...`. Values are never written to disk.
#
# These op:// paths must match the actual vault structure. If you rename a
# vault or item in 1Password, update these references and re-restart the
# MCP server (Cmd+Q Claude Desktop, reopen).
URLSCAN_API_KEY=op://Wavefront-Clients/GRIFFON-phish-triage/urlscan_api_key
ABUSEIPDB_API_KEY=op://Wavefront-Clients/GRIFFON-phish-triage/abuseipdb_api_key
GOOGLE_SAFE_BROWSING_API_KEY=op://Wavefront-Clients/GRIFFON-phish-triage/google_safe_browsing_api_key
